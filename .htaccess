# RENOVA Immobilien Tirol, Website von archivisu
Options -Indexes
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^ https://www.renovatirol.at%{REQUEST_URI} [L,R=301]
RewriteCond %{HTTP_HOST} !^www\.renovatirol\.at$ [NC]
RewriteRule ^ https://www.renovatirol.at%{REQUEST_URI} [L,R=301]
</IfModule>
<IfModule mod_headers.c>
<FilesMatch "\.(jpg|jpeg|png|svg|ico|woff2|mp4)$">
Header set Cache-Control "public, max-age=31536000"
</FilesMatch>
<FilesMatch "\.html$">
Header set Cache-Control "no-cache"
</FilesMatch>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
<FilesMatch "^\.git">
Require all denied
</FilesMatch>
